# ============================================================================
# Things 3 GTD MCP Server -- Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# All variables are optional EXCEPT THINGS_AUTH_TOKEN, which is required for
# any write operation (create / update / delete).
# ============================================================================

# --- REQUIRED -------------------------------------------------------------
# Things 3 -> Settings -> General -> Enable Things URLs -> Manage -> Reveal Token
THINGS_AUTH_TOKEN=

# --- SERVER BIND ----------------------------------------------------------
# Default: localhost (loopback only, recommended).
# Use 0.0.0.0 only if you intentionally want LAN access.
THINGS_MCP_HOST=localhost
THINGS_MCP_PORT=8009

# --- AUTHENTICATION -------------------------------------------------------
# When true, /mcp requests must include
#   Authorization: Bearer <THINGS_AUTH_TOKEN>
# Recommended whenever the server is exposed beyond loopback.
THINGS_MCP_REQUIRE_AUTH=false

# --- DIAGNOSTICS ----------------------------------------------------------
# Verbose console logging.
THINGS_MCP_DEBUG=false

# Show Things 3 in the foreground when an AppleScript runs (debug only).
THINGS_MCP_DISABLE_BACKGROUND_OSASCRIPT=false

# --- OPTIONAL: REMOTE-ACCESS HEALTH CHECK ---------------------------------
# Used only by `scripts/health-check.sh` to verify your ngrok tunnel.
# Set to your own ngrok subdomain to enable that check.
# THINGS_MCP_NGROK_DOMAIN=your-domain.ngrok-free.dev
