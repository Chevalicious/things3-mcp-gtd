# Optional. If using .env, put it in the server's working directory and chmod 600 it.
# Prefer your client's private environment settings for stdio.
# THINGS_MCP_TRANSPORT=stdio
# THINGS_MCP_READ_ONLY=true

# Existing-item updates only. Get this from Things > Settings > General > Things URLs.
# THINGS_AUTH_TOKEN=
# Optional. Only missing tag creation uses AppleScript and may prompt for Automation.
# THINGS_MCP_ALLOW_TAG_CREATION=false

# Streamable HTTP only. Binding is limited to loopback.
# THINGS_MCP_HOST=127.0.0.1
# THINGS_MCP_PORT=8009
# THINGS_MCP_HTTP_TOKEN=
# THINGS_MCP_REQUIRE_AUTH=true
# THINGS_MCP_DEBUG=false
